# Copiar como .env y cambiar los valores (el .env NO se sube a GitHub).
# Los valores de este archivo son SOLO PARA DESARROLLO.

# MySQL: los servicios se conectan como root (la clave solo se aplica la primera vez que se crea el volumen mysqldata)
MYSQL_ROOT_PASSWORD=mysql-solo-desarrollo

# RabbitMQ
RABBITMQ_USER=transcargo
RABBITMQ_PASSWORD=rabbit-solo-desarrollo

# Clave JWT compartida por ms-auth y el gateway (mínimo 32 caracteres).
# En producción genera una propia, por ejemplo: openssl rand -base64 48
JWT_SECRET=cambiar-esta-clave-solo-desarrollo-minimo-32-bytes
JWT_EXPIRATION_MS=3600000

# Orígenes permitidos por CORS en el gateway (separados por coma, * = todos)
CORS_ORIGENES=*

# Memoria de cada JVM (opcional; este es el valor por defecto del compose)
# JAVA_OPTS=-Xms64m -Xmx192m -XX:MaxMetaspaceSize=128m -Xss512k -XX:+UseSerialGC
