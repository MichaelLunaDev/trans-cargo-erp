{
 "info": {
  "name": "TRANS-CARGO ERP",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Ejecutar las carpetas en orden con Runner. Todo pasa por el gateway."
 },
 "item": [
  {
   "name": "00 Datos aleatorios (ejecutar primero)",
   "item": [
    {
     "name": "Generar placa, DNI y usuario",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "var L='ABCDEFGHJKLMNPRSTUVWXYZ'; var pl=''; for(var i=0;i<3;i++){pl+=L.charAt(Math.floor(Math.random()*L.length));} pm.collectionVariables.set('placa', pl+'-'+Math.floor(100+Math.random()*899));",
         "pm.collectionVariables.set('dni',String(Math.floor(10000000+Math.random()*89999999)));",
         "pm.collectionVariables.set('lic','Q'+Math.floor(10000000+Math.random()*89999999));",
         "pm.collectionVariables.set('user','user'+Math.floor(Math.random()*100000));",
         "pm.collectionVariables.set('serie','T'+Math.floor(100+Math.random()*899));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// solo genera variables; la respuesta del servidor no importa"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{base_url}}/auth/login",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "login"
       ]
      },
      "auth": {
       "type": "noauth"
      }
     }
    }
   ]
  },
  {
   "name": "01 Autenticacion",
   "item": [
    {
     "name": "Registrar usuario",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Registro 2xx', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/auth/register",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"username\": \"{{user}}\",\n  \"password\": \"Clave12345\",\n  \"email\": \"{{user}}@correo.com\",\n  \"rol\": \"DESPACHADOR\"\n}"
      }
     }
    },
    {
     "name": "Login (guarda el token)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Login 200', function(){ pm.response.to.have.status(200); });",
         "pm.collectionVariables.set('token', pm.response.json().token);"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/auth/login",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "login"
       ]
      },
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"username\": \"{{user}}\",\n  \"password\": \"Clave12345\"\n}"
      }
     }
    },
    {
     "name": "Sin token -> 401",
